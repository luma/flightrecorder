# flightrecorder local development configuration.
# Copy this file to .env before running make dev-up, make migrate-up, or make serve.

ENVIRONMENT=development
LOG_LEVEL=info

# HTTP API and embedded admin UI.
API_PORT=8080
API_BASE_PATH=/
API_EXIT_GRACE_PERIOD=3s
WEB_BASE_URL=http://localhost:8080
ENABLE_PPROF=false

# Local docker-compose Postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=flightrecorder
POSTGRES_PASSWORD=flightrecorder
POSTGRES_DB=flightrecorder
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_CONNECTIONS=30
POSTGRES_MIN_CONNECTIONS=5
POSTGRES_CONN_TIMEOUT=10s

# Ingestion limits and bug-report screenshot storage.
MAX_EVENTS_PER_BATCH=50
REPORT_RATE_LIMIT_SECONDS=60
REPORT_STORAGE_BACKEND=local
REPORT_STORAGE_DIR=var/reports
ALLOW_SCREENSHOT_FAILURES=true

# Admin UI auth. Development login accepts addresses from ADMIN_ALLOWED_EMAILS.
ADMIN_DEV_LOGIN=true
ADMIN_ALLOWED_EMAILS=admin@example.com
ADMIN_SESSION_SECRET=dev-admin-session-secret-change-me
ADMIN_SESSION_DURATION=12h

# R2/S3-compatible screenshot storage. Leave blank while REPORT_STORAGE_BACKEND=local.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
